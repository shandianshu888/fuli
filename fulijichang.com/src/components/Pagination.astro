---
const { current, total, base } = Astro.props;
---
{total>1&&<nav class="pagination" aria-label="分页">{current>1&&<a rel="prev" href={current===2?base:`${base}page/${current-1}/`}>上一页</a>}{Array.from({length:total},(_,i)=>i+1).map(p=><a href={p===1?base:`${base}page/${p}/`} aria-current={p===current?'page':undefined}>{p}</a>)}{current<total&&<a rel="next" href={`${base}page/${current+1}/`}>下一页</a>}</nav>}
