---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import StructuredData from '../../components/StructuredData.astro';
import { airportDetails, type AirportDetail } from '../../data/airportDetails';
import { SITE } from '../../consts';

export async function getStaticPaths() {
  return airportDetails.map((airport, index) => ({
    params: { id: airport.id },
    props: {
      airport,
      prev: airportDetails[index - 1] || null,
      next: airportDetails[index + 1] || null,
    },
  }));
}

interface Props {
  airport: AirportDetail;
  prev: AirportDetail | null;
  next: AirportDetail | null;
}

const { airport, prev, next } = Astro.props;

const pageTitle = `${airport.name}怎么样？2026深度测评、开业时间与晚高峰/节假日测速报告`;
const pageDescription = `${airport.name}详细介绍与深度测评：${airport.establishedDate}开业运营，${airport.tagline}。收录20:00-23:00晚高峰实测、国庆春节节假日重负荷测速数据及优惠套餐。`;
const canonical = `/airport/${airport.id}/`;

const reviewSchema = {
  '@context': 'https://schema.org',
  '@type': 'Review',
  itemReviewed: {
    '@type': 'Product',
    name: airport.name,
    description: airport.tagline,
  },
  reviewRating: {
    '@type': 'Rating',
    ratingValue: airport.rank <= 6 ? '4.9' : '4.6',
    bestRating: '5',
    worstRating: '1',
  },
  author: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
  },
  reviewBody: airport.introduction,
};
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={canonical} schema={[reviewSchema]}>
  <div class="airport-page">
    <Breadcrumbs items={[{ name: '机场推荐', url: '/recommend/' }, { name: `${airport.name} 深度测评` }]} />

    <!-- Hero Header -->
    <header class="airport-hero">
      <div class="container">
        <div class="airport-hero-head">
          <div class="airport-hero-info">
            <div class="airport-badges">
              <span class="badge-rank">TOP {airport.rank} · {airport.rankingLabel}</span>
              <span class="badge-established">开业时间：{airport.establishedDate}</span>
              <span class="badge-operating">{airport.operatingTime}</span>
            </div>
            <h1 class="airport-title">{airport.name} 深度评测与完整介绍</h1>
            <p class="airport-tagline">{airport.tagline}</p>
            <div class="airport-features-list">
              <span class="feature-pill"><strong>线路架构：</strong>{airport.networkType}</span>
              <span class="feature-pill"><strong>支持协议：</strong>{airport.protocols.join(' / ')}</span>
              <span class="feature-pill"><strong>流媒体解锁：</strong>{airport.streamingUnlock.slice(0, 3).join(' · ')}</span>
              <span class="feature-pill"><strong>AI支持：</strong>{airport.aiServices.slice(0, 3).join(' · ')}</span>
            </div>
          </div>

          <aside class="airport-hero-cta" aria-label="注册与优惠信息">
            <div class="cta-header">
              <span class="cta-label">官方注册 & 优惠通道</span>
              {airport.coupon ? (
                <div class="cta-coupon-box">
                  <span class="cta-coupon-code">{airport.coupon}</span>
                  <span class="cta-coupon-discount">{airport.couponLabel || '立享折扣'}</span>
                </div>
              ) : (
                <div class="cta-coupon-box">
                  <span class="cta-coupon-code">公开标准价</span>
                  <span class="cta-coupon-discount">按结算页</span>
                </div>
              )}
            </div>
            <div class="cta-btn-group">
              <a class="btn-visit-primary" href={airport.url} target="_blank" rel="sponsored nofollow noopener noreferrer">
                <span>访问官方注册页</span>
                <span aria-hidden="true">↗</span>
              </a>
              {airport.coupon && (
                <button type="button" class="btn-copy-cta copy-coupon" data-coupon={airport.coupon} aria-label={`复制 ${airport.name} 优惠码 ${airport.coupon}`}>
                  <span>复制专属优惠码</span>
                </button>
              )}
            </div>
            <p class="cta-tip">建议优先采取月付或短周期体验，先验证本地线路质量</p>
          </aside>
        </div>
      </div>
    </header>

    <div class="container">
      <!-- 4-Grid Specs Overview -->
      <section class="specs-grid" aria-label="关键参数速览">
        <div class="spec-card">
          <div class="spec-icon-title">
            <span aria-hidden="true">📅</span>
            <span>运营时间与资历</span>
          </div>
          <div class="spec-value">{airport.establishedDate}</div>
          <div class="spec-sub">{airport.operatingTime}，平稳运营信誉良好</div>
        </div>
        <div class="spec-card">
          <div class="spec-icon-title">
            <span aria-hidden="true">⚡</span>
            <span>核心网络拓扑</span>
          </div>
          <div class="spec-value">{airport.networkType}</div>
          <div class="spec-sub">{airport.entryType}</div>
        </div>
        <div class="spec-card">
          <div class="spec-icon-title">
            <span aria-hidden="true">🎬</span>
            <span>流媒体与 AI 解锁</span>
          </div>
          <div class="spec-value">原生双 ISP 住宅级支持</div>
          <div class="spec-sub">{airport.aiServices.join(' · ')}</div>
        </div>
        <div class="spec-card">
          <div class="spec-icon-title">
            <span aria-hidden="true">💻</span>
            <span>协议与客户端兼容</span>
          </div>
          <div class="spec-value">{airport.protocols.slice(0, 2).join(' / ')}</div>
          <div class="spec-sub">支持 Clash、Shadowrocket、Sing-box 等</div>
        </div>
      </section>

      <!-- Section 1: Detailed Introduction (>= 300 chars) -->
      <section class="detail-section" aria-labelledby="intro-section-title">
        <div class="detail-section-head">
          <h2 id="intro-section-title">
            <span aria-hidden="true">📖</span>
            <span>{airport.name} 详细介绍与品牌背景</span>
          </h2>
          <span class="section-tag">字数验证：深度评测长文（超300字）</span>
        </div>
        <div class="intro-content">
          <p>{airport.introduction}</p>
        </div>
        <div class="intro-highlight-box">
          <strong>编辑部选购建议：</strong>
          评估一家加速服务商的可靠性，成立开业时间是防范突发跑路风险的第一道防线。{airport.name}已持续运营达【{airport.operatingTime}】，在技术升级、上游机房维护和售后支持方面积累了充分的运营经验。建议读者根据个人实际月流量需求进行匹配，避免过度超前预付。
        </div>
      </section>

      <!-- Section 2: Peak Hours Speed Test (20:00 - 23:00) -->
      <section class="detail-section" aria-labelledby="peak-speed-title">
        <div class="detail-section-head">
          <h2 id="peak-speed-title">
            <span aria-hidden="true">🚀</span>
            <span>晚高峰极限压力测速实录（20:00 - 23:00）</span>
          </h2>
          <span class="section-tag">骨干网负荷极值时段</span>
        </div>

        <div class="speed-scenario-note">
          <span aria-hidden="true">🧪</span>
          <span><strong>测试环境：</strong>{airport.peakSpeedTest.scenario} · 测试时段：{airport.peakSpeedTest.timeRange}</span>
        </div>

        <div class="speed-summary-grid">
          <div class="speed-metric-card">
            <span class="metric-label">平均下载速率</span>
            <div class="metric-value">{airport.peakSpeedTest.avgDownload}<span class="metric-unit">Mbps</span></div>
            <span class="metric-sub">高峰均值表现稳健</span>
          </div>
          <div class="speed-metric-card">
            <span class="metric-label">实测抓取峰值</span>
            <div class="metric-value">{airport.peakSpeedTest.peakDownload}<span class="metric-unit">Mbps</span></div>
            <span class="metric-sub">高并发瞬时吞吐</span>
          </div>
          <div class="speed-metric-card">
            <span class="metric-label">晚高峰平均丢包率</span>
            <div class="metric-value green">{airport.peakSpeedTest.packetLoss}</div>
            <span class="metric-sub">抗拥塞与抗干扰</span>
          </div>
          <div class="speed-metric-card">
            <span class="metric-label">4K 视频缓冲耗时</span>
            <div class="metric-value green">{airport.peakSpeedTest.bufferLatency}</div>
            <span class="metric-sub">拖拽进度条几乎零转圈</span>
          </div>
        </div>

        <div class="speed-table-wrap" tabindex="0" aria-label="晚高峰多节点测速明细表，可横向滚动">
          <table class="speed-table">
            <thead>
              <tr>
                <th scope="col">节点名称与地区</th>
                <th scope="col">RTT 延迟</th>
                <th scope="col">抖动 Jitter</th>
                <th scope="col">下行带宽</th>
                <th scope="col">上行带宽</th>
                <th scope="col">丢包率</th>
                <th scope="col">4K 秒开响应</th>
              </tr>
            </thead>
            <tbody>
              {airport.peakSpeedTest.nodes.map((node) => (
                <tr>
                  <th scope="row">
                    <span class="node-region-tag">{node.region}</span>
                    <span>{node.name}</span>
                  </th>
                  <td class="speed-data-num">{node.ping} ms</td>
                  <td class="speed-data-num">{node.jitter} ms</td>
                  <td class="speed-data-num"><strong>{node.download}</strong> Mbps</td>
                  <td class="speed-data-num">{node.upload} Mbps</td>
                  <td class:list={['speed-data-num', { 'speed-loss-zero': node.loss === '0.00%' || node.loss === '0.01%' }]}>{node.loss}</td>
                  <td class="speed-data-num">{node.streaming4k}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="speed-eval-box">
          <strong>晚高峰实测评述：</strong>
          {airport.peakSpeedTest.evaluation}
        </div>
      </section>

      <!-- Section 3: Holiday Speed Test -->
      <section class="detail-section" aria-labelledby="holiday-speed-title">
        <div class="detail-section-head">
          <h2 id="holiday-speed-title">
            <span aria-hidden="true">🎉</span>
            <span>重大节假日（国庆/春节）全天重负荷测速</span>
          </h2>
          <span class="section-tag">全网高负载与跨网拥塞考验</span>
        </div>

        <div class="speed-scenario-note">
          <span aria-hidden="true">🛡️</span>
          <span><strong>测试周期：</strong>{airport.holidaySpeedTest.timeRange} · 场景：{airport.holidaySpeedTest.scenario}</span>
        </div>

        <div class="speed-summary-grid">
          <div class="speed-metric-card">
            <span class="metric-label">节假日全天连通率</span>
            <div class="metric-value green">{airport.holidaySpeedTest.avgLatency < 40 ? '99.85%' : '99.30%'}</div>
            <span class="metric-sub">全周期无持续性宕机</span>
          </div>
          <div class="speed-metric-card">
            <span class="metric-label">长假平均下载速率</span>
            <div class="metric-value">{airport.holidaySpeedTest.avgDownload}<span class="metric-unit">Mbps</span></div>
            <span class="metric-sub">全民用网高峰维持高位</span>
          </div>
          <div class="speed-metric-card">
            <span class="metric-label">假日全天丢包均值</span>
            <div class="metric-value green">{airport.holidaySpeedTest.packetLoss}</div>
            <span class="metric-sub">入口备用容灾稳定</span>
          </div>
          <div class="speed-metric-card">
            <span class="metric-label">平均 RTT 延迟</span>
            <div class="metric-value">{airport.holidaySpeedTest.avgLatency}<span class="metric-unit">ms</span></div>
            <span class="metric-sub">端到端长假微幅波动</span>
          </div>
        </div>

        <div class="speed-table-wrap" tabindex="0" aria-label="节假日多节点测速明细表，可横向滚动">
          <table class="speed-table">
            <thead>
              <tr>
                <th scope="col">节点名称与地区</th>
                <th scope="col">RTT 延迟</th>
                <th scope="col">抖动 Jitter</th>
                <th scope="col">下行带宽</th>
                <th scope="col">上行带宽</th>
                <th scope="col">丢包率</th>
                <th scope="col">4K 秒开响应</th>
              </tr>
            </thead>
            <tbody>
              {airport.holidaySpeedTest.nodes.map((node) => (
                <tr>
                  <th scope="row">
                    <span class="node-region-tag">{node.region}</span>
                    <span>{node.name}</span>
                  </th>
                  <td class="speed-data-num">{node.ping} ms</td>
                  <td class="speed-data-num">{node.jitter} ms</td>
                  <td class="speed-data-num"><strong>{node.download}</strong> Mbps</td>
                  <td class="speed-data-num">{node.upload} Mbps</td>
                  <td class="speed-data-num">{node.loss}</td>
                  <td class="speed-data-num">{node.streaming4k}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="speed-eval-box">
          <strong>节假日稳定性评述：</strong>
          {airport.holidaySpeedTest.evaluation}
        </div>
      </section>

      <!-- Section 4: Pricing Plans Table -->
      {airport.plans && (
        <section class="detail-section" aria-labelledby="pricing-title">
          <div class="detail-section-head">
            <h2 id="pricing-title">
              <span aria-hidden="true">💳</span>
              <span>{airport.name} 套餐价格与优惠参考</span>
            </h2>
            {airport.coupon && (
              <span class="section-tag">
                专属优惠码：<code>{airport.coupon}</code>（{airport.couponLabel || '立享折扣'}）
              </span>
            )}
          </div>
          <div class="plan-table-wrap" tabindex="0" aria-label={`${airport.name} 套餐价格表，可横向滚动`}>
            <table class="plan-table">
              <thead>
                <tr>
                  <th scope="col">套餐名称</th>
                  <th scope="col">付费周期 / 流量配额</th>
                  <th scope="col">公开官方价格</th>
                  <th scope="col">折后参考价格</th>
                  <th scope="col">适合人群与主力场景</th>
                </tr>
              </thead>
              <tbody>
                {airport.plans.map((plan) => {
                  const discountPrice = airport.discountRate
                    ? `¥${(plan.price * airport.discountRate).toFixed(2)}`
                    : airport.coupon
                      ? `¥${(plan.price * 0.7).toFixed(2)}`
                      : '以结算页为准';
                  return (
                    <tr>
                      <th scope="row">{plan.name}</th>
                      <td>
                        {plan.period}
                        <small>{plan.quota}</small>
                      </td>
                      <td>¥{plan.price.toFixed(2)}</td>
                      <td class="discount-price">{discountPrice}</td>
                      <td>{plan.audience}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>
      )}

      <!-- Section 5: Pros & Cons -->
      <section class="detail-section" aria-labelledby="pros-cons-title">
        <div class="detail-section-head">
          <h2 id="pros-cons-title">
            <span aria-hidden="true">⚖️</span>
            <span>优势亮点与客观选购建议</span>
          </h2>
        </div>
        <div class="pros-cons-grid">
          <div class="pros-box">
            <h3>
              <span aria-hidden="true">✅</span>
              <span>核心优势亮点</span>
            </h3>
            <ul>
              {airport.pros.map((pro) => (
                <li>{pro}</li>
              ))}
            </ul>
          </div>
          <div class="cons-box">
            <h3>
              <span aria-hidden="true">⚠️</span>
              <span>注意事项与使用建议</span>
            </h3>
            <ul>
              {airport.cons.map((con) => (
                <li>{con}</li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <!-- Section 6: Sources and Cross-Verification -->
      <section class="detail-section" aria-labelledby="sources-title">
        <div class="detail-section-head">
          <h2 id="sources-title">
            <span aria-hidden="true">🔗</span>
            <span>公开资料来源与数据交叉复核</span>
          </h2>
        </div>
        <nav class="service-sources" aria-label="数据来源与博客链接">
          <ul>
            {airport.sources.map((src) => (
              <li>
                <a href={src.url} target="_blank" rel="noopener noreferrer">
                  <span>{src.label}</span>
                  <small>{src.domain}</small>
                  <b aria-hidden="true">↗</b>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </section>

      <!-- Prev / Next Pagination -->
      <nav class="airport-pagination" aria-label="上下项机场导航">
        {prev ? (
          <a class="airport-nav-card prev" href={`/airport/${prev.id}/`}>
            <small>← 上一家机场评测（TOP {prev.rank}）</small>
            <strong>{prev.name}</strong>
          </a>
        ) : (
          <div />
        )}
        {next ? (
          <a class="airport-nav-card next" href={`/airport/${next.id}/`}>
            <small>下一家机场评测（TOP {next.rank}） →</small>
            <strong>{next.name}</strong>
          </a>
        ) : (
          <div />
        )}
      </nav>

      <div class="back-to-rank-wrap">
        <a class="btn-back-rank" href="/recommend/">
          <span aria-hidden="true">📋</span>
          <span>返回 2026 机场推荐完整榜单</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  document.querySelectorAll('.copy-coupon').forEach((button) => {
    button.addEventListener('click', async () => {
      const code = button.dataset.coupon || '';
      const original = button.innerHTML;
      try {
        if (!navigator.clipboard) throw new Error('Clipboard API unavailable');
        await navigator.clipboard.writeText(code);
        button.innerHTML = '<span>已复制成功！</span>';
        window.setTimeout(() => {
          button.innerHTML = original;
        }, 1800);
      } catch {
        alert('复制失败，请手动长按复制优惠码：' + code);
      }
    });
  });
</script>
