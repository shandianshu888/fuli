---
import { getCollection } from 'astro:content'; import BaseLayout from '../layouts/BaseLayout.astro'; import CategoryCard from '../components/CategoryCard.astro'; import ArticleCard from '../components/ArticleCard.astro'; import { CATEGORIES,SITE } from '../consts'; import { newest } from '../utils/articles';
const articles=newest(await getCollection('articles')); const latest=articles.slice(0,6);const featured=articles.filter(a=>a.data.featured).slice(0,3);const by=(c:string)=>articles.filter(a=>a.data.category===c).slice(0,3);
---
<BaseLayout title={SITE.name} description={SITE.description} canonical="/" schema={[{'@context':'https://schema.org','@type':'WebPage',name:SITE.name,description:SITE.description,url:SITE.url}]}>
<header class="hero"><div class="container hero-grid"><div class="hero-copy"><div class="eyebrow">独立中文网络服务内容博客</div><h1>先看清，再领取真正适合你的福利</h1><p>整理公开信息、套餐价格、优惠信息、产品体验与风险观察。我们区分事实、用户反馈和编辑判断，帮助你更从容地比较网络服务。</p><div class="tag-list"><a class="button" href="/recommend/">查看机场推荐</a><a class="tag" href="/knowledge/">新手从知识库开始</a><a class="tag" href="/about/">了解编辑原则</a></div></div><aside class="benefit-ticket" aria-label="本站福利内容特色"><span class="ticket-label">BENEFIT GUIDE · 福利指南</span><strong>优惠不只看折扣<br/>更要看是否合适</strong><ul><li><span>公开套餐</span><span>清楚比较</span></li><li><span>优惠信息</span><span>标注条件</span></li><li><span>风险观察</span><span>持续更新</span></li></ul></aside></div></header>
<section class="section"><div class="container"><div class="section-head"><h2>按主题浏览</h2><span class="meta">七个长期维护的内容栏目</span></div><div class="category-grid">{Object.values(CATEGORIES).map((c,i)=><CategoryCard {...c} index={i+1}/>)}</div></div></section>
<section class="section alt"><div class="container"><div class="section-head"><h2>最新文章</h2><a href="/search/">搜索全部内容 →</a></div><div class="article-grid">{latest.map((a,i)=><ArticleCard article={a} eager={i<3}/>)}</div></div></section>
{featured.length>0&&<section class="section"><div class="container"><div class="section-head"><h2>编辑精选</h2><span class="meta">基于信息完整度与长期参考价值</span></div><div class="article-grid">{featured.map(a=><ArticleCard article={a}/>)}</div></div></section>}
<section class="section alt"><div class="container"><div class="section-head"><h2>对比与选择</h2><a href="/compare/">查看机场对比 →</a></div><div class="article-grid">{[...by('compare'),...by('recommend')].slice(0,3).map(a=><ArticleCard article={a}/>)}</div></div></section>
<section class="section"><div class="container"><div class="section-head"><h2>新手知识与风险提示</h2><a href="/risk/">查看风险观察 →</a></div><div class="article-grid">{[...by('knowledge'),...by('risk')].slice(0,3).map(a=><ArticleCard article={a}/>)}</div></div></section>
<section class="section alt"><div class="container"><div class="section-head"><h2>福利信息与常见问答</h2><a href="/faq/">查看问题解答 →</a></div><div class="article-grid">{[...by('deals'),...by('faq')].slice(0,3).map(a=><ArticleCard article={a}/>)}</div></div></section>
</BaseLayout>
