---

<div class="faq-hub">
  <div class="faq-hero-box">
    <div class="faq-quick-search">
      <span class="faq-search-icon">🔍</span>
      <input type="search" id="faq-search-input" placeholder="输入关键词搜索 30+ 常见问题，如：一元机场、小火箭、免费节点、倍率、ChatGPT、退款..." autocomplete="off" />
    </div>
    <div class="faq-nav-tabs" id="faq-tabs">
      <button class="faq-tab active" data-target="all">🌟 全部 30 个解答</button>
      {faqCategories.map(cat => (
        <button class="faq-tab" data-target={cat.id}>
          <span>{cat.icon}</span> {cat.title.replace('问答', '')}
        </button>
      ))}
    </div>
  </div>

  <div id="faq-list-container">
    {faqCategories.map(cat => (
      <section class="faq-category-group" data-category={cat.id} style={`--group-theme: ${cat.color}`}>
        <div class="faq-group-header">
          <span class="faq-group-icon">{cat.icon}</span>
          <h2>{cat.title}</h2>
          <span class="faq-group-count">{cat.items.length} 个解答</span>
        </div>
        <div class="faq-items-list">
          {cat.items.map((item, idx) => (
            <details class="faq-item" data-search-text={`${item.q} ${item.a}`}>
              <summary class="faq-summary">
                <span class="faq-q-badge">Q{idx + 1}</span>
                <span class="faq-q-text">{item.q}</span>
                <span class="faq-arrow" aria-hidden="true">❯</span>
              </summary>
              <div class="faq-answer">
                <div class="faq-a-badge">A</div>
                <div class="faq-a-content">
                  <p>{item.a}</p>
                </div>
              </div>
            </details>
          ))}
        </div>
      </section>
    ))}
  </div>

  <div id="faq-no-results" class="empty" hidden>
    🔍 未找到匹配的问题，请尝试输入其他关键词，或在上方导航切换分类。
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const input = document.getElementById('faq-search-input');
    const tabs = document.querySelectorAll('#faq-tabs .faq-tab');
    const groups = document.querySelectorAll('.faq-category-group');
    const items = document.querySelectorAll('.faq-item');
    const noResults = document.getElementById('faq-no-results');

    let currentTab = 'all';

    function filterFAQ() {
      const query = input ? input.value.trim().toLowerCase() : '';
      let visibleCount = 0;

      groups.forEach(group => {
        const catId = group.getAttribute('data-category');
        const matchesTab = (currentTab === 'all' || currentTab === catId);
        let groupVisibleItems = 0;

        const groupItems = group.querySelectorAll('.faq-item');
        groupItems.forEach(item => {
          const text = item.getAttribute('data-search-text')?.toLowerCase() || '';
          const matchesQuery = !query || text.includes(query);

          if (matchesTab && matchesQuery) {
            item.removeAttribute('hidden');
            if (query) item.setAttribute('open', 'true');
            groupVisibleItems++;
          } else {
            item.setAttribute('hidden', 'true');
          }
        });

        if (groupVisibleItems > 0) {
          group.removeAttribute('hidden');
          visibleCount += groupVisibleItems;
        } else {
          group.setAttribute('hidden', 'true');
        }
      });

      if (noResults) {
        noResults.hidden = (visibleCount > 0);
      }
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        currentTab = tab.getAttribute('data-target') || 'all';
        filterFAQ();
      });
    });

    if (input) {
      input.addEventListener('input', filterFAQ);
    }
  });
</script>

<style>
  .faq-hub {
    margin-top: 10px;
  }
  .faq-hero-box {
    background: #fffdfa;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 32px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.03);
  }
  .faq-quick-search {
    position: relative;
    margin-bottom: 20px;
  }
  .faq-search-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 18px;
    pointer-events: none;
  }
  .faq-quick-search input {
    width: 100%;
    padding: 14px 16px 14px 48px;
    border: 2px solid var(--line);
    border-radius: 10px;
    font-size: 15px;
    background: #ffffff;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .faq-quick-search input:focus {
    border-color: #0d9488;
    box-shadow: 0 0 0 3px rgba(13, 148, 136, 0.15);
    outline: none;
  }
  .faq-nav-tabs {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .faq-tab {
    border: 1px solid var(--line);
    background: #f7f3ed;
    color: var(--ink);
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .faq-tab:hover {
    background: #ede6dc;
