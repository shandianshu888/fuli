---
import {getCollection} from 'astro:content';import BaseLayout from '../layouts/BaseLayout.astro';import ArticleCard from '../components/ArticleCard.astro';import Breadcrumbs from '../components/Breadcrumbs.astro';import {newest} from '../utils/articles';const articles=newest(await getCollection('articles'));
---
<BaseLayout title="站内搜索" description="搜索福利机场观察的文章、栏目与知识内容。" canonical="/search/" noindex={true}><Breadcrumbs items={[{name:'搜索'}]}/><header class="page-head"><div class="container"><h1>站内搜索</h1><p>按文章标题、摘要与标签筛选。全部内容在关闭 JavaScript 时仍可浏览。</p><form class="search-form" role="search"><label class="sr-only" for="q">搜索关键词</label><input id="q" name="q" type="search" placeholder="例如：选择标准、账户安全、服务失联" autocomplete="off"/><button class="button" type="submit">搜索</button></form></div></header><section class="section"><div class="container"><p id="search-status" class="meta" aria-live="polite">显示全部 {articles.length} 篇文章</p><div class="article-grid" id="results">{articles.map(a=><ArticleCard article={a}/>)}</div><div class="empty" id="empty" hidden>没有匹配内容，请尝试更简短的关键词。</div></div></section>
<script is:inline>const input=document.querySelector('#q');const items=[...document.querySelectorAll('[data-search-item]')];const status=document.querySelector('#search-status');const empty=document.querySelector('#empty');const run=()=>{const q=input.value.trim().toLowerCase();let n=0;items.forEach(el=>{const hit=!q||(el.dataset.title+' '+el.dataset.description+' '+el.dataset.tags).toLowerCase().includes(q);el.hidden=!hit;if(hit)n++});status.textContent=q?`找到 ${n} 篇匹配文章`:`显示全部 ${n} 篇文章`;empty.hidden=n>0;history.replaceState(null,'',q?`?q=${encodeURIComponent(q)}`:location.pathname)};const initial=new URLSearchParams(location.search).get('q')||'';input.value=initial;run();document.querySelector('.search-form').addEventListener('submit',e=>{e.preventDefault();run()});input.addEventListener('input',run);</script></BaseLayout>
