---
interface Item { name:string; href?:string }
const { items } = Astro.props as { items: Item[] };
---
<nav class="breadcrumbs container" aria-label="面包屑"><ol><li><a href="/">首页</a></li>{items.map((item)=><><li aria-hidden="true">/</li><li>{item.href?<a href={item.href}>{item.name}</a>:<span aria-current="page">{item.name}</span>}</li></>)}</ol></nav>
