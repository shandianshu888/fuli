---
import type { CollectionEntry } from 'astro:content'; import BaseLayout from './BaseLayout.astro'; import Breadcrumbs from '../components/Breadcrumbs.astro'; import TableOfContents from '../components/TableOfContents.astro'; import SourceList from '../components/SourceList.astro'; import FAQ from '../components/FAQ.astro'; import ArticleCard from '../components/ArticleCard.astro'; import { CATEGORIES,SITE } from '../consts'; import { articlePath,formatDate,readingTime } from '../utils/articles';
const { article, headings, body, prev, next, related=[] }=Astro.props as {article:CollectionEntry<'articles'>;headings:any[];body:string;prev?:CollectionEntry<'articles'>;next?:CollectionEntry<'articles'>;related:CollectionEntry<'articles'>[]};
const d=article.data;const path=articlePath(article.id);const cover=new URL(d.cover.src,SITE.url).toString();const crumbs=[{name:CATEGORIES[d.category].name,href:CATEGORIES[d.category].path},{name:d.title}];
const schemas=[{'@context':'https://schema.org','@type':'BlogPosting',headline:d.title,description:d.description,image:cover,datePublished:d.publishDate.toISOString(),dateModified:d.updatedDate.toISOString(),author:{'@type':'Person',name:d.author},editor:{'@type':'Person',name:d.reviewer},mainEntityOfPage:new URL(path,SITE.url).toString(),publisher:{'@type':'Organization',name:SITE.name,url:SITE.url}}, {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:crumbs.map((c,i)=>({'@type':'ListItem',position:i+2,name:c.name,item:c.href?new URL(c.href,SITE.url).toString():undefined}))}, ...(d.faq.length?[{'@context':'https://schema.org','@type':'FAQPage',mainEntity:d.faq.map(x=>({'@type':'Question',name:x.question,acceptedAnswer:{'@type':'Answer',text:x.answer}}))}]:[])];
---
<BaseLayout title={d.seoTitle||d.title} description={d.description} canonical={d.canonical||path} image={d.cover.src} type="article" noindex={d.noindex} schema={schemas}>
  <Breadcrumbs items={crumbs}/><article><header class="page-head"><div class="container"><div class="eyebrow">{CATEGORIES[d.category].name}</div><h1>{d.title}</h1><p class="article-intro">{d.description}</p><div class="meta">作者：{d.author} · 审核：{d.reviewer} · 发布于 <time datetime={d.publishDate.toISOString()}>{formatDate(d.publishDate)}</time> · 更新于 <time datetime={d.updatedDate.toISOString()}>{formatDate(d.updatedDate)}</time> · 约 {readingTime(body)} 分钟阅读</div></div></header>
  <div class="container section content-layout"><div><figure><img src={d.cover.src} width={d.cover.width} height={d.cover.height} alt={d.coverAlt} loading="eager" decoding="async"/><figcaption class="meta">示意图：用于说明文章主题，不代表特定服务或测试结论。</figcaption></figure><div class="prose"><slot/><FAQ items={d.faq}/><SourceList sources={d.sources}/></div>
  <div class="info-box"><strong>内容更新提示</strong><p>本文最后更新于 {formatDate(d.updatedDate)}。价格、服务条款与可用性可能变化，请以服务商公开页面为准，并遵守所在地法律法规及相关服务条款。</p></div>
  <div class="tag-list">{d.tags.map(t=><a class="tag" href={`/tags/${encodeURIComponent(t)}/`}>#{t}</a>)}</div><div class="author-box"><div><strong>作者：{d.author}</strong><p>负责公开资料整理、编辑与内容维护。</p></div><div><strong>审核：{d.reviewer}</strong><p>复核事实与观点标注、来源及风险提示。</p></div></div>
  <nav class="article-nav" aria-label="相邻文章">{prev?<a rel="prev" href={articlePath(prev.id)}>← 上一篇<br/><strong>{prev.data.title}</strong></a>:<span/>}{next&&<a rel="next" href={articlePath(next.id)}>下一篇 →<br/><strong>{next.data.title}</strong></a>}</nav></div><TableOfContents {headings}/></div></article>
  {related.length>0&&<section class="section alt"><div class="container"><div class="section-head"><h2>相关文章</h2></div><div class="article-grid">{related.map(a=><ArticleCard article={a}/>)}</div></div></section>}
</BaseLayout>
